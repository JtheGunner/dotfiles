# Root Loops palette - the single source of truth for terminal colors.
#
# To change the theme:
#   1. Pick a recipe at the URL in ./RECIPE (update that file).
#   2. On rootloops.sh open the "Shell" export and copy the 16 colors +
#      foreground/background into the values below (hex, no leading '#').
#   3. Run ./apply.sh to re-render every generated color file.
#   4. Commit; on other machines `git pull && rootloops/apply.sh`.
#
# Everything that can inherit the 16 ANSI colors (bat, tmux, delta, starship)
# needs no generated file - only emitters that don't inherit cleanly do
# (the terminal emulator itself, fzf's UI chrome, a bare TTY, neovim).

RL_BG=192036
RL_FG=cdd5eb

RL_COLOR0=2b3554
RL_COLOR1=fb80aa
RL_COLOR2=a1bd22
RL_COLOR3=f49437
RL_COLOR4=56b8f7
RL_COLOR5=bd97fc
RL_COLOR6=28c8b1
RL_COLOR7=909fcc
RL_COLOR8=4b5987
RL_COLOR9=fda7c1
RL_COLOR10=b5d427
RL_COLOR11=fcb173
RL_COLOR12=89cdfc
RL_COLOR13=ceb5fd
RL_COLOR14=30e1c7
RL_COLOR15=c0cae5
