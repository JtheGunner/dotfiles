# No identity here on purpose: this repo is public, and whoever stows it must
# not commit as its author. useConfigOnly makes git refuse to commit until a
# name + email are set explicitly - in ~/.gitconfig.local (see below), which
# bootstrap.sh offers to create and never overwrites.
[user]
	useConfigOnly = true

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[fetch]
	prune = true

# git ignores a missing include.
# ~/.gitconfig.delta - delta paging/diff config, GENERATED by bootstrap.sh only
#                      when `delta` is installed (git-delta is not in Debian stable).
# ~/.gitconfig.local - yours: identity (user.name / user.email) and any other
#                      per-machine overrides. Not version-controlled. Included
#                      last so it wins.
[include]
	path = ~/.gitconfig.delta
[include]
	path = ~/.gitconfig.local

[alias]
	st = status
	s = status
	ci = commit -v
	c = commit -v
	co = checkout
	cob = checkout -b
	coi = !git checkout $(git branch --sort=committerdate | fzf)
	br = branch
	d = diff
	dd = diff --cached
	cp = cherry-pick
	ps = push
	pl = pull
	pb = pull --rebase
	l = log --oneline --graph
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
