[user]
	name = Jeffry Würmli
	email = jeffry.wuermli@gmail.com

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[fetch]
	prune = true

# delta paging/diff config - written by bootstrap.sh only when `delta` is
# installed (git-delta is not in Debian stable). git ignores a missing include.
[include]
	path = ~/.gitconfig.local

[alias]
	st = status
	s = status
	ci = commit -v
	c = commit -v
	co = checkout
	cob = checkout -b
	coi = !git checkout $(git branch --sort=committerdate | fzf)
	br = branch
	d = diff
	dd = diff --cached
	cp = cherry-pick
	ps = push
	pl = pull
	pb = pull --rebase
	l = log --oneline --graph
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
