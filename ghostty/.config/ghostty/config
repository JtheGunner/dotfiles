# Ghostty configuration.
#
# Colors: Root Loops, via two generated themes (rootloops/apply.sh writes
# themes/rootloops-dark and themes/rootloops-light). This `theme` line is the
# ONLY place colors are set - don't add background/foreground/palette below or
# a stray second `theme`, either would fight this.
theme = light:rootloops-light,dark:rootloops-dark

# ─── Font ───────────────────────────────────────────────────────────────
font-family = "Cascadia Mono NF"
font-synthetic-style = false
font-size = 12
font-feature = +calt
font-feature = +liga
font-feature = +zero
font-thicken = true
adjust-cell-height = 50%
adjust-cell-width = 8%

# ─── Cursor ─────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
adjust-cursor-thickness = 2
adjust-cursor-height = 1
# cursor trail effect (sahaj-b/ghostty-cursor-shaders)
custom-shader = shaders/cursor_warp.glsl

# ─── Window ─────────────────────────────────────────────────────────────
window-height = 45
window-width = 180
window-padding-x = 8
window-padding-y = 1
window-padding-balance = true
window-save-state = never
window-new-tab-position = current
background-opacity = 0.98

# ─── Quick terminal ─────────────────────────────────────────────────────
quick-terminal-position = center
quick-terminal-size = 70%,70%
quick-terminal-animation-duration = 0

# ─── Notifications ──────────────────────────────────────────────────────
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# ─── Misc ───────────────────────────────────────────────────────────────
confirm-close-surface = true
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true
auto-update-channel = stable

# ─── macOS-only appearance (ignored elsewhere) ──────────────────────────
macos-option-as-alt = false
macos-titlebar-style = tabs

# ─── Keybindings ────────────────────────────────────────────────────────
# Platform-specific: bootstrap.sh links ~/.config/ghostty-keybinds.conf to
# keybinds-mac.conf (macOS, `super` = Cmd) or keybinds-linux.conf (everywhere else,
# `ctrl+shift`). Includes load after this file, so they win. Override the choice
# with DOTFILES_GHOSTTY_KEYBINDS=auto|mac|linux.
config-file = ?~/.config/ghostty-keybinds.conf

# Auto-copy on mouse selection.
copy-on-select = clipboard

# Per-machine overrides, not version-controlled (optional). Lives OUTSIDE the
# stowed ~/.config/ghostty symlink so edits don't land in the repo. Good place
# for e.g. `background-blur = macos-glass-regular` + a lower `background-opacity`
# on a recent macOS.
config-file = ?~/.config/ghostty.local
