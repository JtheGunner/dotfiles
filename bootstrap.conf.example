# Bootstrap settings for bootstrap.sh - machine-specific, not version-controlled.
#
# bootstrap.sh copies this template to ~/.config/dotfiles/bootstrap.conf on the
# first run and never overwrites that file afterwards. Uncomment a line to change
# a setting.
#
# Format: KEY=value, one per line; '#' starts a comment. The file is parsed, never
# executed. Unknown keys and invalid values are reported and ignored.
# Precedence: command-line flag > environment variable > this file > default.

# Install zsh when it is missing: yes | no | ask
# Only an explicit "yes" installs it; --yes alone never does. "ask" prompts when a
# terminal is available and otherwise prints a hint.
# Flags: --install-zsh / --no-install-zsh    Environment: DOTFILES_INSTALL_ZSH
#INSTALL_ZSH=ask

# Answer "yes" to every prompt, e.g. switch rc files and stow links from another
# checkout to this one: yes | no
# Flag: --yes    Environment: DOTFILES_ASSUME_YES (1 or 0)
#ASSUME_YES=no

# Extra terminal stow packages, separated by spaces (Ghostty is always stowed).
# Environment: DOTFILES_TERMINALS
#TERMINALS=
